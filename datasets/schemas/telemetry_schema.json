{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CyberSleuth Telemetry Event",
  "description": "Normalized cybersecurity event telemetry schema for CyberSleuth",
  "type": "object",
  "required": ["timestamp", "event_type"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for the telemetry event"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when the event occurred"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "AUTH_FAILURE",
        "AUTH_SUCCESS",
        "PROCESS_CREATE",
        "NETWORK_CONNECT",
        "DNS_QUERY",
        "POWERSHELL_EXEC",
        "FILE_MOD",
        "PRIVILEGE_ESCALATION"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "default": "INFO"
    },
    "user": {
      "type": "string",
      "description": "User account associated with the event"
    },
    "host": {
      "type": "string",
      "description": "Hostname or asset name"
    },
    "source_ip": {
      "type": "string",
      "description": "Source IP address"
    },
    "destination_ip": {
      "type": "string",
      "description": "Destination IP address"
    },
    "source_port": {
      "type": "integer"
    },
    "destination_port": {
      "type": "integer"
    },
    "protocol": {
      "type": "string"
    },
    "process_name": {
      "type": "string"
    },
    "process_path": {
      "type": "string"
    },
    "parent_process": {
      "type": "string"
    },
    "command_line": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "hash": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  }
}
