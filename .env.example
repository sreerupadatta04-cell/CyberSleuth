# CyberSleuth Environment Configuration Template
PROJECT_NAME="CyberSleuth"
ENVIRONMENT="development"
DEBUG=True

# Backend Network & Storage
PORT=8000
HOST="127.0.0.1"
DATABASE_URL="sqlite:///./cybersleuth.db"

# LLM Providers Configuration (Dual Live LLM Integration)
LLM_PROVIDER="gemini"
LLM_FALLBACK_PROVIDER="openai"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

LLM_LIVE_REASONING=true
LLM_ALLOW_DETERMINISTIC_FALLBACK=true

# Telemetry Limits
MAX_UPLOAD_SIZE_MB=10
