# ==========================================
# CyberSleuth Comprehensive .gitignore
# ==========================================

# 1. Environment & API Secrets (CRITICAL)
.env
*.env
**/.env
**/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!**/.env.example

# 2. Virtual Environments & Python Packages
.venv/
**/.venv/
venv/
**/venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.Python

# 3. Python Bytecode & Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# 4. Databases & SQLite Artifacts
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3
cybersleuth.db
backend/cybersleuth.db
backend/app/cybersleuth.db

# 5. Frontend Node & Build Outputs
node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# 6. Uploads, Private Telemetry & Generated Artifacts
uploads/
**/uploads/
backend/uploads/
reports/*.pdf
*.pdf
logs/
**/logs/
*.log
**/*.log

# 7. Operating System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
